.ocp-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ocp {
    position: absolute;
    flex-direction: column;
    overflow: hidden;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    color: rgb(238, 240, 244);
}

.ocp--edge {
    border-radius: 0;
    border-width: 0;
}

.ocp Label {
    color: rgb(238, 240, 244);
    padding: 0;
    margin: 0;
}

.ocp-head {
    flex-direction: row;
    align-items: center;
    padding: 22px 28px 10px 28px;
}

.ocp-title {
    -unity-font-style: bold;
}

.ocp .ocp-pill {
    margin-left: 12px;
    padding: 3px 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(110, 163, 245, 0.35);
    background-color: rgba(110, 163, 245, 0.12);
    color: rgb(159, 194, 255);
    -unity-text-align: middle-center;
}

.ocp-tabs {
    flex-direction: row;
    align-self: flex-start;
    margin: 0 28px 4px 28px;
    padding: 4px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06);
}

.ocp-tab {
    margin: 0 2px;
    padding: 0 22px;
    border-width: 0;
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.55);
}

.ocp .ocp-tab:hover:enabled {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.8);
}

.ocp .ocp-tab:hover:active:enabled {
    background-color: rgba(255, 255, 255, 0.09);
}

.ocp .ocp-tab--selected,
.ocp .ocp-tab--selected:hover:enabled,
.ocp .ocp-tab--selected:hover:active:enabled {
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(255, 255, 255);
}

.ocp-scroll {
    flex-grow: 1;
}

.ocp-scroll .unity-scroll-view__content-container {
    padding: 14px 28px;
}

.ocp-scroll .unity-scroller--vertical {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ocp-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ocp-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    border-width: 0;
    border-radius: 4px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(255, 255, 255, 0.2);
}

.ocp-scroll .unity-scroller--vertical .unity-repeat-button {
    display: none;
}

.ocp .ocp-header {
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.ocp .ocp-header {
    color: rgb(154, 163, 180);
}

.ocp-row {
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.035);
}

.ocp-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.ocp .ocp-label {
    flex-shrink: 0;
    margin-right: 12px;
    -unity-text-align: middle-left;
}

.ocp-label--ellipsis {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ocp-label--wrap {
    white-space: normal;
}

.ocp-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.ocp-field > * {
    margin: 0 4px;
}

.ocp-grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ocp .ocp-axis {
    margin: 0 2px 0 6px;
    color: rgba(255, 255, 255, 0.5);
}

.ocp .unity-base-field {
    margin: 0;
}

.ocp .unity-base-text-field__input,
.ocp .unity-base-popup-field__input {
    padding: 0 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(0, 0, 0, 0.25);
    color: rgb(255, 255, 255);
}

.ocp .unity-base-text-field__input:hover,
.ocp .unity-base-popup-field__input:hover {
    border-color: rgba(255, 255, 255, 0.18);
}

.ocp .unity-base-text-field:focus > .unity-base-text-field__input {
    border-color: rgb(110, 163, 245);
}

.ocp .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
}

.ocp-slider-value {
    flex-grow: 0;
    flex-shrink: 0;
    width: 110px;
}

.ocp .unity-base-slider__tracker {
    border-width: 0;
    border-radius: 3px;
    height: 6px;
    margin-top: -3px;
    background-color: rgba(255, 255, 255, 0.16);
}

.ocp .unity-base-slider__dragger {
    width: 20px;
    height: 20px;
    margin-top: -10px;
    border-width: 0;
    border-radius: 10px;
    background-color: rgb(255, 255, 255);
}

.ocp .unity-base-slider__dragger-border {
    display: none;
}

.ocp-switch {
    flex-grow: 0;
}

.ocp-switch .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    width: 52px;
    height: 30px;
}

.ocp-switch .unity-toggle__checkmark {
    width: 52px;
    height: 30px;
    padding: 3px;
    border-width: 0;
    border-radius: 15px;
    background-color: rgba(255, 255, 255, 0.18);
    background-image: none;
    justify-content: center;
    align-items: flex-start;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.ocp-switch:checked .unity-toggle__checkmark {
    background-image: none;
    background-color: rgb(63, 123, 224);
    align-items: flex-end;
}

.ocp-switch-knob {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgb(255, 255, 255);
}

.ocp-swatch {
    flex-shrink: 0;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.25);
}

.ocp-button {
    margin: 0 0 0 10px;
    padding: 0 18px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(255, 255, 255, 0.16);
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ocp .ocp-button:hover:enabled {
    background-color: rgba(255, 255, 255, 0.2);
}

.ocp .ocp-button:hover:active:enabled {
    background-color: rgba(255, 255, 255, 0.28);
}

.ocp-button:disabled {
    opacity: 0.5;
}

.ocp-button--primary {
    border-color: rgb(63, 123, 224);
    background-color: rgb(63, 123, 224);
}

.ocp .ocp-button--primary:hover:enabled {
    background-color: rgb(84, 140, 235);
}

.ocp .ocp-button--primary:hover:active:enabled {
    background-color: rgb(52, 108, 204);
}

.ocp-button--danger {
    border-color: rgba(255, 138, 128, 0.45);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 138, 128);
}

.ocp .ocp-button--danger:hover:enabled {
    background-color: rgba(255, 138, 128, 0.1);
}

.ocp .ocp-button--danger:hover:active:enabled {
    background-color: rgba(255, 138, 128, 0.2);
}

.ocp-button--ghost {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(196, 202, 214);
}

.ocp .ocp-button--ghost:hover:enabled {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(255, 255, 255);
}

.ocp .ocp-button--ghost:hover:active:enabled {
    background-color: rgba(255, 255, 255, 0.12);
}

.ocp-foot {
    flex-direction: row;
    align-items: center;
    padding: 16px 28px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.ocp-foot > .ocp-button--danger {
    margin-left: 0;
}

.ocp .ocp-error {
    color: rgb(227, 87, 77);
    white-space: normal;
}

.ocp-command {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 14px 16px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.035);
}

.ocp-command__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 14px;
}

.ocp-command__title {
    white-space: normal;
}

.ocp .ocp-command__description {
    color: rgb(153, 161, 176);
    white-space: normal;
}

.ocp-status-dot {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    border-radius: 6px;
}

.ocp-status-dot--running {
    background-color: rgb(224, 179, 64);
}

.ocp-status-dot--succeeded {
    background-color: rgb(64, 179, 128);
}

.ocp-status-dot--failed {
    background-color: rgb(227, 87, 77);
}

.ocp-confirm {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.ocp-confirm__box {
    width: 60%;
    padding: 28px;
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(30, 32, 41);
}

.ocp .ocp-confirm__message {
    margin-bottom: 24px;
    white-space: normal;
}

.ocp-confirm__buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.ocp-lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.ocp-lock Label {
    color: rgb(242, 244, 247);
    -unity-text-align: middle-center;
}

.ocp-lock__title {
    font-size: 34px;
    margin-bottom: 28px;
}

.ocp-lock__dots {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 14px;
}

.ocp-lock__dot {
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.7);
}

.ocp-lock__dot--filled {
    border-color: rgb(255, 255, 255);
    background-color: rgb(255, 255, 255);
}

.ocp-lock .ocp-lock__error {
    min-height: 28px;
    margin-bottom: 14px;
    font-size: 22px;
    color: rgb(255, 107, 107);
}

.ocp-lock__row {
    flex-direction: row;
}

.ocp-lock__key {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.14);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.ocp-lock .ocp-lock__key:hover:enabled {
    background-color: rgba(255, 255, 255, 0.2);
}

.ocp-lock .ocp-lock__key:hover:active:enabled {
    background-color: rgba(255, 255, 255, 0.4);
}

.ocp-lock__key--ghost {
    background-color: rgba(0, 0, 0, 0);
}

.ocp-lock .ocp-lock__key--ghost:hover:enabled {
    background-color: rgba(255, 255, 255, 0.06);
}

.ocp-lock .ocp-lock__key--ghost:hover:active:enabled {
    background-color: rgba(255, 255, 255, 0.12);
}
